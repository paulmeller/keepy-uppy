build/
# SwiftPM's build directory, which shows up untracked in every `git status`
# the moment anything runs `swift build`.
.build/
*.xcuserstate
xcuserdata/
DerivedData/
.superpowers/

# Generated from project.yml by xcodegen; every build path regenerates it.
# Tracking it meant the committed copy silently drifted from the source of
# truth — three times, most recently building none of SessionCompletionTests.
*.xcodeproj/
